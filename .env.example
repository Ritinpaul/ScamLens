# ScamLens Configuration

# Local Inference Provider (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:latest
MODEL_REQUEST_TIMEOUT_SECONDS=90

# Backend Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# OCR Configuration
OCR_ENABLED=true
OCR_LANGUAGES=en
